{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Awake",
  "mainBinaryName": "awake-tray",
  "identifier": "dev.awake.tray",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Keep your machine awake and your status Available",
    "longDescription": "Tray app that inhibits system sleep and resets the OS input idle timer so VPNs, agents and connections stay alive and Teams/Slack keep showing Available.",
    "copyright": "Copyright © 2026 Alec Winter",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/OWNER/awake/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
