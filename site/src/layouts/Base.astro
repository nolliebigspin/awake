---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import { author, name } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** schema.org object(s) for this page, emitted as JSON-LD. */
  jsonLd?: object;
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
// With build.format "file" the pathname is /index.html or /privacy.html;
// canonical URLs are the clean ones Vercel serves (/ and /privacy).
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/";
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
// Escape "<" so page content can never close the script element early.
const ldJson = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="awake: keep your machine awake and your status Available. macOS, Windows, Linux." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="awake for LLMs" />
    {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}
  </head>
  <body>
    <slot />

    <footer>
      <nav aria-label="Footer">
        <a href="/">Home</a>
        <a href="https://github.com/nolliebigspin/awake">GitHub</a>
        <a href="https://github.com/nolliebigspin/awake/blob/main/LICENSE">MIT License</a>
        <a href="/privacy">Privacy</a>
        <a href="https://awinter.dev/imprint">Imprint / Impressum</a>
      </nav>
      <p class="small">© 2026 {author.name} · Made by <a href={author.url}>awinter.dev</a></p>
      <p class="small">
        The software is provided "as is", without warranty of any kind. Microsoft Teams and Slack are trademarks of their
        respective owners. awake is not affiliated with, endorsed by or sponsored by Microsoft or Slack.
      </p>
    </footer>

    <Analytics />
  </body>
</html>
